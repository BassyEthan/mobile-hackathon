{
  "expo": {
    "name": "Dumpling",
    "slug": "mobile-hackathon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilehackathon",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bassyethan.mobilehackathon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EE8152",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bassyethan.mobilehackathon"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EE8152",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 168
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Dumpling uses the camera to record your ten-second Fold.",
          "microphonePermission": "Dumpling uses the microphone for your Fold and voice reactions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dumpling uses the microphone for your Fold and voice reactions."
        }
      ],
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FFF6E9"
  }
}
